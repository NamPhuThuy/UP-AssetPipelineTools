/* ═══════════════════════════════════════════════════════════
   Window_AssetNaming.uss
   Place at: Assets/_Project/Module RPManage/UP_AssetPipelineTools/Window_AssetNaming.uss
   ═══════════════════════════════════════════════════════════ */

/* ── Root ──────────────────────────────────────────────────── */
.root {
    flex-direction: column;
    padding: 14px;
    background-color: #222222;
}

/* ── Header ────────────────────────────────────────────────── */
.header-label {
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: #87ceeb;
    margin-bottom: 2px;
}

/* ── Section box ───────────────────────────────────────────── */
.section-box {
    background-color: rgba(26, 26, 26, 0.6);
    border-color: rgba(42, 42, 42, 0.8);
    border-width: 1px;
    border-radius: 4px;
    padding: 12px;
    margin-bottom: 12px;
}

.section-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: #87ceeb;
    margin-bottom: 8px;
}

/* ── Toolbar row ───────────────────────────────────────────── */
.toolbar-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
    flex-wrap: wrap;
}

.toolbar-btn {
    margin-left: 4px;
    padding: 3px 10px;
    background-color: rgba(26, 26, 26, 0.6);
    color: #cccccc;
    border-color: rgba(42, 42, 42, 0.8);
    border-radius: 4px;
}

.toolbar-btn:hover {
    background-color: #333333;
}

/* ── Apply button ──────────────────────────────────────────── */
.apply-btn {
    align-self: center;
    padding: 6px 24px;
    margin-top: 10px;
    background-color: #0078bd;
    color: white;
    -unity-font-style: bold;
    border-radius: 4px;
    border-color: #005c91;
}

.apply-btn:hover {
    background-color: #008cdb;
}

/* ── Rename All button ─────────────────────────────────────── */
.rename-all-btn {
    height: 40px;
    font-size: 14px;
    -unity-font-style: bold;
    background-color: #0078bd;
    color: white;
    border-radius: 4px;
    border-color: #005c91;
    margin-top: 8px;
}

.rename-all-btn:hover {
    background-color: #008cdb;
}

/* ── Rule row (global template) ────────────────────────────── */
.rule-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
}

/* ── Part columns ──────────────────────────────────────────── */
.part-column {
    flex-direction: column;
    min-width: 240px;
    margin-right: 10px;
}

.col-label {
    font-size: 11px;
    color: #aaaaaa;
    margin-bottom: 2px;
}

.main-name-col {
    background-color: #2b2b2b;
    border-color: #444444;
    border-width: 1px;
    border-radius: 4px;
    padding: 6px;
    margin-right: 10px;
    min-width: 200px;
}

/* ── Name part box ─────────────────────────────────────────── */
.name-part-box {
    background-color: #2b2b2b;
    border-color: #444444;
    border-width: 1px;
    border-radius: 3px;
    padding: 4px;
    margin-bottom: 4px;
}

.part-row {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

/* ── Add part button ───────────────────────────────────────── */
.add-part-btn {
    background-color: #333333;
    color: #87ceeb;
    border-color: #444444;
    border-radius: 3px;
    padding: 3px 8px;
    margin-bottom: 4px;
    height: 24px;
}

.add-part-btn:hover {
    background-color: #444444;
}

/* ── Remove button ─────────────────────────────────────────── */
.remove-btn {
    width: 20px;
    height: 20px;
    background-color: #552222;
    color: #ffaaaa;
    border-color: #663333;
    border-radius: 3px;
    padding: 0;
    margin-left: 4px;
    font-size: 10px;
}

.remove-btn:hover {
    background-color: #663333;
}

/* ── Replace row ───────────────────────────────────────────── */
.replace-row {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 6px;
    padding: 4px;
    background-color: #1a1a1a;
    border-radius: 3px;
}

.replace-row Label {
    margin-left: 4px;
    margin-right: 4px;
    color: #cccccc;
    font-size: 11px;
}

/* ── Record row ────────────────────────────────────────────── */
.record-row {
    flex-direction: row;
    align-items: center;
    background-color: rgba(26, 26, 26, 0.4);
    border-color: rgba(42, 42, 42, 0.6);
    border-width: 1px;
    border-radius: 3px;
    padding: 4px;
    margin-bottom: 3px;
    flex-wrap: wrap;
}

.record-row:hover {
    background-color: rgba(26, 26, 26, 0.8);
}

/* ── Inline rule (compact inside record rows) ──────────────── */
.inline-rule {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-wrap: wrap;
}

.inline-rule .part-column {
    min-width: 140px;
    margin-right: 6px;
}

.inline-rule .main-name-col {
    min-width: 140px;
    padding: 3px;
}

.inline-rule .name-part-box {
    padding: 2px;
}

.inline-rule .add-part-btn {
    font-size: 10px;
    height: 20px;
    padding: 1px 5px;
}

/* ── Preview label ─────────────────────────────────────────── */
.preview-label {
    -unity-font-style: bold;
    color: #87ceeb;
    font-size: 12px;
    margin-left: 8px;
    white-space: normal;
    min-width: 120px;
}

/* ── Drop area ─────────────────────────────────────────────── */
.drop-area {
    height: 44px;
    background-color: #1a1a1a;
    border-color: #444444;
    border-width: 1px;
    border-style: solid;
    border-radius: 4px;
    align-items: center;
    justify-content: center;
    margin-top: 6px;
}

.drop-area:hover {
    border-color: #87ceeb;
    background-color: #222222;
}

.drop-label {
    color: #888888;
    font-size: 12px;
    -unity-font-style: italic;
}
